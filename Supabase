--Views
CREATE OR REPLACE VIEW vw_reservas_ativas AS
SELECT 
    r.id_reserva,
    hs.id_hospede,
    hs.nome AS nome_hospede,
    hs.email,
    hs.telefone,
    ht.nome,
    ht.cidade,
    r.data_checkin,
    r.data_checkout,
    r.valor_diaria,
    (r.data_checkout - r.data_checkin) AS total_noites,
    ((r.data_checkout - r.data_checkin) * r.valor_diaria) AS valor_total_estimado
FROM reservas r
JOIN hospedes hs ON r.id_hospede = hs.id_hospede
JOIN hoteis ht ON r.id_hotel = ht.id_hotel
WHERE r.status = 'ATIVA';

CREATE OR REPLACE VIEW vw_resumo_gastos_hospedes AS
SELECT 
    hs.id_hospede,
    hs.nome,
    COUNT(r.id_reserva) AS quantidade_reservas,
    COALESCE(SUM((r.data_checkout - r.data_checkin) * r.valor_diaria), 0.00) AS valor_total_gasto
FROM hospedes hs
LEFT JOIN reservas r ON hs.id_hospede = r.id_hospede AND r.status != 'CANCELADA'
GROUP BY hs.id_hospede, hs.nome;

CREATE OR REPLACE VIEW vw_faturamento_mensal_projetado AS
SELECT 
    TO_CHAR(r.data_checkin, 'YYYY-MM') AS ano_mes,
    COUNT(r.id_reserva) AS total_reservas,
    SUM((r.data_checkout - r.data_checkin) * r.valor_diaria) AS faturamento_total
FROM reservas r
WHERE r.status != 'CANCELADA'
GROUP BY TO_CHAR(r.data_checkin, 'YYYY-MM')
ORDER BY ano_mes DESC;

CREATE OR REPLACE VIEW vw_hoteis_por_cidade AS
SELECT
    ht.nome,
    ht.telefone,
    ht.comodidades,
    ht.avaliação
FROM hoteis ht
GROUP BY cidade;
