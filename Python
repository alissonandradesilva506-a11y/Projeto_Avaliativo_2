app = FastAPI(title="Estadia")

class DateTimeEncoder(json.JSONEncoder):
    def default(self, obj):
        if isinstance(obj, (date, datetime)):
            return obj.isoformat()
        return super().default(obj)

@app.get("/api/hoteis", status_code=status.HTTP_200_OK)
def get_hoteis_por_cidade(cidade: str = Query(..., description="Nome da cidade para busca")):
    cidade_key = cidade.strip().lower()
    cache_key = f"hoteis:cidade:{cidade_key}"

    try:
      cached_data = redis_client.get(cache_key)
        if cached_data:
            return {"source": "cache", "data": json.loads(cached_data)}
        response = supabase.table("hoteis").select("*").ilike("cidade", f"%{cidade_key}%").execute()
        hoteis = response.data

        if hoteis:
            redis_client.setex(cache_key, 300, json.dumps(hoteis, cls=DateTimeEncoder))

        return {"source": "database", "data": hoteis}

    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

