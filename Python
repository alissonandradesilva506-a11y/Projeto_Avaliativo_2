# 2. CRIAÇÃO DE RESERVA COM CONCORRÊNCIA (Redis Lock)
# -------------------------------------------------------------------------
@app.post("/api/reservas", status_code=status.HTTP_201_CREATED)
def criar_reserva(reserva: ReservaCreate):
    # Converte as datas para string para montar a chave do lock
    checkin_str = reserva.data_checkin.isoformat()
    checkout_str = reserva.data_checkout.isoformat()
    
    # Chave única que representa o recurso concorrente (Hotel + Período)
    lock_key = f"lock:hotel:{reserva.id_hotel}:{checkin_str}:{checkout_str}"
    
    # Tenta adquirir o Lock (nx=True garante que só cria se não existir)
    # ex=10 define que o lock expira em 10 segundos caso a aplicação caia no meio do processo
    adquiriu_lock = redis_client.set(lock_key, str(reserva.id_hospede), nx=True, ex=10)

    if not adquiriu_lock:
        raise HTTPException(
            status_code=status.HTTP_409_CONFLICT,
            detail="Este hotel já possui uma tentativa de reserva em andamento para estas datas. Tente novamente em instantes."
        )

    try:
        # Validação no Supabase: Verifica se já existe reserva CONFIRMADA/ATIVA sobreposta
        # Lógica SQL: (checkin_existente <= checkout_solicitado) AND (checkout_existente >= checkin_solicitado)
        query = supabase.table("reservas").select("id_reserva") \
            .eq("id_hotel", reserva.id_hotel) \
            .eq("status", "ATIVA") \
            .lte("data_checkin", checkout_str) \
            .gte("data_checkout", checkin_str) \
            .execute()

        if query.data:
            # Se já houver conflito real no banco, remove o lock e rejeita
            redis_client.delete(lock_key)
            raise HTTPException(status_code=400, detail="O hotel já está reservado de forma definitiva neste período.")

        # Insere a nova reserva no Supabase
        nova_reserva_response = supabase.table("reservas").insert({
            "id_hospede": reserva.id_hospede,
            "id_hotel": reserva.id_hotel,
            "data_checkin": checkin_str,
            "data_checkout": checkout_str,
            "valor_diaria": float(reserva.valor_diaria),
            "status": "ATIVA"
        }).execute()

        # Invalida o cache da cidade para atualizar a exibição se necessário
        hotel_query = supabase.table("hoteis").select("cidade").eq("id_hotel", reserva.id_hotel).single().execute()
        if hotel_query.data:
            cidade_hotel = hotel_query.data["cidade"].lower()
            redis_client.delete(f"hoteis:cidade:{cidade_hotel}")

        # Libera o lock com sucesso
        redis_client.delete(lock_key)

        return {"message": "Reserva criada com sucesso!", "data": nova_reserva_response.data}

    except HTTPException:
        # Repassa exceções HTTP criadas dentro do bloco try (como o erro 400 de quarto ocupado)
        raise
    except Exception as e:
        # Garante a liberação do lock em caso de falhas inesperadas de rede ou banco de dados
        redis_client.delete(lock_key)
        raise HTTPException(status_code=500, detail=str(e))

def registrar_visualizacao_hotel(id_hotel: int):
    # Incrementa em 1 o score do 'id_hotel' dentro do ranking geral
    redis_client.zincrby("hoteis:ranking_popularidade", 1, str(id_hotel))

def obter_hoteis_populares():
    hoteis_populares = redis_client.zrevrange("hoteis:ranking_popularidade", 0, 4, withscores=True)
    return [{"id_hotel": int(id), "visualizacoes": int(score)} for id, score in hoteis_populares]

def iniciar_checkout_temporario(id_hotel: int, id_hospede: int, data_in: str, data_out: str):
    hold_key = f"hold:hotel:{id_hotel}:{data_in}:{data_out}"

    sucesso = redis_client.set(hold_key, str(id_hospede), ex=900, nx=True)
    return sucesso  # Retorna True se conseguiu segurar, False se já estava ocupado

def cancelar_checkout_temporario(id_hotel: int, data_in: str, data_out: str):
    hold_key = f"hold:hotel:{id_hotel}:{data_in}:{data_out}"
    redis_client.delete(hold_key)

def registrar_historico_visita(id_hospede: int, id_hotel: int):
    history_key = f"hospede:{id_hospede}:historico"
    
    redis_client.lrem(history_key, 0, str(id_hotel))
    
    redis_client.lpush(history_key, str(id_hotel))

    redis_client.ltrim(history_key, 0, 4)

def obter_historico_visita(id_hospede: int):
    history_key = f"hospede:{id_hospede}:historico"
    return redis_client.lrange(history_key, 0, -1)

def verificar_limite_requisicoes(ip_usuario: str):
    rate_key = f"rate:limit:{ip_usuario}"

    requisicoes_atuais = redis_client.incr(rate_key)

    if requisicoes_atuais == 1:
        redis_client.expire(rate_key, 60)

    if requisicoes_atuais > 60:
        raise HTTPException(status_code=429, detail="Muitas requisições. Tente novamente em um minuto.")

def deslogar_e_bloquear_token(token_jwt: str, tempo_expiracao_segundos: int):
    blacklist_key = f"blacklist:token:{token_jwt}"

    redis_client.setex(blacklist_key, tempo_expiracao_segundos, "revogado")

def verificar_se_token_valido(token_jwt: str):
    blacklist_key = f"blacklist:token:{token_jwt}"
    if redis_client.exists(blacklist_key):
        raise HTTPException(status_code=401, detail="Token revogado. Faça login novamente.")
